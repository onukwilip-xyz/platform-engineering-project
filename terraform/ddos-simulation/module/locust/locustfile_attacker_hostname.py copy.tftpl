# Generated by Terraform — do not edit on the VM. Edit the .tftpl in the
# ddos-simulation module and re-apply; the GCS object is recreated and
# workers pick it up on the next instance recycle.
import uuid
from locust import HttpUser, task, constant_throughput


class AttackerHostnameUser(HttpUser):
    """Attacker workload that targets the public Gateway by FQDN.

    Each simulated user generates 1 RPS (constant_throughput(1.0)). With the
    plan's default of 10 users per VM × 2 VMs = 20 users, this profile sends
    ~20 RPS at the gateway — well above Cloud Armor's 300/min throttle and
    550/min ban thresholds, so we expect rapid throttle → ban → cycle.
    """

    host = "https://${target_public_host}"
    wait_time = constant_throughput(1.0)

    @task
    def write_user(self):
        unique_email = f"u-{uuid.uuid4()}@test.local"
        self.client.post(
            "/users",
            json={"email": unique_email, "name": f"Test {unique_email}", "mobile": "+2349077788867"},
            headers={"Host": "${target_public_host}"},
            name="POST /users",
        )