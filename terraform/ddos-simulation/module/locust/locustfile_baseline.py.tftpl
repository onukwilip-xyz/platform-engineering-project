# Generated by Terraform — do not edit on the VM. Edit the .tftpl in the
# ddos-simulation module and re-apply; the GCS object is recreated and
# workers pick it up on the next instance recycle.
import uuid
from locust import HttpUser, task, constant_throughput


class BaselineUser(HttpUser):
    """Baseline workload — same code path as attacker_hostname so the
    backend pods see identical request shapes, but driven at much lower
    intensity (4 users × 1 VM = 4 RPS, well under Cloud Armor's 300/min
    throttle threshold).

    Kept as a separate file so baseline parameters (wait_time jitter,
    different endpoints, think-time variability) can be tuned later without
    touching the attacker profiles.
    """

    host = "https://${target_public_host}"
    wait_time = constant_throughput(1.0)

    @task
    def write_user(self):
        unique_email = f"u-{uuid.uuid4()}@test.local"
        self.client.get(
            "/",
            headers={"Host": "${target_public_host}"},
            name="GET /",
        )
