# Generated by Terraform — do not edit on the VM. Edit the .tftpl in the
# ddos-simulation module and re-apply; the GCS object is recreated and
# workers pick it up on the next instance recycle.
import uuid
from locust import HttpUser, task, constant_throughput


class AttackerIpUser(HttpUser):
    """Attacker workload that targets the public Gateway by IP, with the
    Host header set to the FQDN so the GKE Gateway's HTTPRoute still matches.

    Validates that Cloud Armor protects IP-direct access too — i.e. an
    attacker who skips DNS doesn't bypass the rate-limit policy.
    """

    host = "https://${target_public_ip}"
    wait_time = constant_throughput(1.0)

    @task
    def write_user(self):
        unique_email = f"u-{uuid.uuid4()}@test.local"
        self.client.post(
            "/users",
            json={"email": unique_email, "name": f"Test {unique_email}", "mobile": "+2349077788867"},
            headers={"Host": "${target_public_host}"},
            name="POST /users",
            # Cloud LBs serve a cert for the FQDN, not the IP — disable
            # cert-name verification only on this profile.
            verify=False,
        )